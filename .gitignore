.venv/
__pycache__/
*.pyc
CLAUDE.md
.env
.DS_Store

# Data files don't belong in git — keep the folders, ignore their contents.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/README.md

# Use-case JSON files are small, non-bulky config (the agent's real objective/key-terms
# definition for a corpus), not bulk export data — track them, unlike the parquet exports.
!data/raw/*.usecase.json

# Local fastembed model cache, if pointed here
.cache/

.ipynb_checkpoints/

# CatBoost's own per-fit training-log directory, written wherever a fit runs locally
catboost_info/
